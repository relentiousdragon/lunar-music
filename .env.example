# copy this file to .env and fill in your values
# 
# discord bot token
# https://discord.com/developers/applications
DISCORD_TOKEN=
# optional; defaults to the bot user ID returned by Discord
DISCORD_APPLICATION_ID=
# comma-separated Discord user IDs allowed to use l.sr
DEV_USER_IDS=
# optional: register slash commands to one guild immediately instead of globally
DISCORD_GUILD_ID=
#
# nodelink node config (recommended)
# add as many nodes as you want - gets read on startup
# format: identifier,host,port,password,secure (true/false)
# ex: main,nodelink.example.com,3000,youshallnotpass,false
# separate multiple nodes with a semicolon:
# NODELINK_NODES=main,nodelink.example.com,3000,password,false;backup,nodelink2.example.com,3000,password,false
NODELINK_NODES=
# optional Spotify Web API credentials for MoonLink-native Spotify search
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ACCESS_TOKEN=
#
# bot prefixes (comma-separated)
# default: ln.,l.
# example: ln.,l.,!music 
BOT_PREFIXES=ln.,l.
#
# synced lyrics
# set to true to enable synced lyrics on the now playing embed
# set to false to disable entirely
SYNCED_LYRICS_ENABLED=true
#
# max concurrent synced lyrics players
# limits how many guilds can have live synced lyrics at the same time
# set to 0 to disable synced lyrics (same as SYNCED_LYRICS_ENABLED=false)
# default: 5, max: 20
MAX_SYNCED_LYRICS_PLAYERS=5
#
# rate limiting: set to true to increase all cooldowns/debounces
# useful when your node or APIs have aggressive rate limits
# increases: search debounce (350→1200ms), filter cooldown (1500→4000ms), button cooldown (2000→5000ms)
RATE_RESPECT_AGGRO=false
#
# bot name
# shown in embed footers and fallback text
# default: Lunar
BOT_NAME=Lunar
# console format: pretty (default) or json
LOG_FORMAT=pretty
#
# Discord Activity (served by this bot on one HTTP/WS port)
# Enable only after completing the Developer Portal setup described in README.
ACTIVITY_ENABLED=false
ACTIVITY_DISCORD_CLIENT_ID=
ACTIVITY_DISCORD_CLIENT_SECRET=
# Must exactly match the OAuth2 Redirect configured in the Discord Developer Portal.
ACTIVITY_REDIRECT_URI=https://127.0.0.1
ACTIVITY_PORT=3001
ACTIVITY_HOST=0.0.0.0
# Set to true to skip TLS - use when a reverse proxy (Cloudflare Tunnel, nginx, caddy)
# handles TLS externally and forwards plain HTTP to the bot.
# Discord Activities require HTTPS, but the proxy provides it, not the bot.
ACTIVITY_ALLOW_INSECURE_LOCAL=true
# Only needed if NOT using a reverse proxy and serving HTTPS directly from the bot:
# ACTIVITY_TLS_KEY_PATH=
# ACTIVITY_TLS_CERT_PATH=
